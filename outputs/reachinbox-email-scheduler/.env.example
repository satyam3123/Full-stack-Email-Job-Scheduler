# Shared services
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"
REDIS_URL="redis://localhost:6379"

# API
PORT=4000
FRONTEND_URL="http://localhost:5173"
SESSION_SECRET="replace-with-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# SMTP: create an Ethereal account at https://ethereal.email/create
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SENDER_ADDRESSES="Outbox <outbox@ethereal.email>,Sales <sales@ethereal.email>"

# Queue and delivery policy
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_CAMPAIGN_DELAY_MS=60000
MAX_CAMPAIGN_HOURLY_LIMIT=1000
